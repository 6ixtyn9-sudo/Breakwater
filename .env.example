VALR_API_KEY=
VALR_API_SECRET=
# Public master/subaccount address only. Never put a wallet private key in this file.
HYPERLIQUID_ACCOUNT_ADDRESS=
BREAKWATER_HYPERLIQUID_NETWORK=mainnet
# Public testnet master/subaccount address. Agent key must be a process secret, never this file.
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=
BREAKWATER_HYPERLIQUID_TESTNET_ACK=off
BREAKWATER_MODE=readonly
BREAKWATER_LIVE_ACK=off
BREAKWATER_DATA_DIR=localdata
BREAKWATER_INITIAL_EQUITY_ZAR=
BREAKWATER_ABSOLUTE_EQUITY_FLOOR_ZAR=
BREAKWATER_MAX_TOTAL_LOSS_ZAR=
BREAKWATER_MAX_TOTAL_DRAWDOWN_FRACTION=
BREAKWATER_RISK_PER_TRADE_ZAR=
BREAKWATER_DAILY_LOSS_LIMIT_ZAR=
BREAKWATER_SEVEN_DAY_LOSS_LIMIT_ZAR=
BREAKWATER_MAX_AGGREGATE_OPEN_RISK_ZAR=
BREAKWATER_MAX_POSITION_NOTIONAL_ZAR=
BREAKWATER_MAX_EFFECTIVE_LEVERAGE=
BREAKWATER_PERP_LEVERAGE_CAP=
BREAKWATER_MAX_POSITIONS=

# Paper-only aggregate stop-risk ceiling (optional ZAR value overrides the fraction)
BREAKWATER_PAPER_MAX_AGGREGATE_RISK_OF_EQUITY=0.05
BREAKWATER_PAPER_MAX_AGGREGATE_OPEN_RISK_ZAR=
# Slippage/gap stress added to aggregate stop risk (set to 0 to disable)
BREAKWATER_PAPER_AGGREGATE_RISK_BUFFER_BPS=25

# Spot margin (OFF by default; requires explicit ack)
BREAKWATER_ENABLE_SPOT_MARGIN_SHORTS=0
BREAKWATER_SPOT_MARGIN_ACK=off
