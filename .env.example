VALR_API_KEY=
VALR_API_SECRET=
# Public master/subaccount address only. Never put a wallet private key in this file.
HYPERLIQUID_ACCOUNT_ADDRESS=
BREAKWATER_HYPERLIQUID_NETWORK=mainnet
# Public testnet master/subaccount address. Agent key must be a process secret, never this file.
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=
BREAKWATER_HYPERLIQUID_TESTNET_ACK=off
BREAKWATER_MODE=readonly
BREAKWATER_LIVE_ACK=off
BREAKWATER_DATA_DIR=localdata
# Preferred private mandate source: one exact JSON object; do not combine with legacy fields below.
BREAKWATER_MANDATE_JSON=
# Legacy mandate fields (migration compatibility only)
BREAKWATER_INITIAL_EQUITY_ZAR=
BREAKWATER_ABSOLUTE_EQUITY_FLOOR_ZAR=
BREAKWATER_MAX_TOTAL_LOSS_ZAR=
BREAKWATER_MAX_TOTAL_DRAWDOWN_FRACTION=
BREAKWATER_RISK_PER_TRADE_ZAR=
BREAKWATER_DAILY_LOSS_LIMIT_ZAR=
BREAKWATER_SEVEN_DAY_LOSS_LIMIT_ZAR=
BREAKWATER_MAX_AGGREGATE_OPEN_RISK_ZAR=
BREAKWATER_MAX_POSITION_NOTIONAL_ZAR=
BREAKWATER_MAX_EFFECTIVE_LEVERAGE=
BREAKWATER_PERP_LEVERAGE_CAP=
BREAKWATER_MAX_POSITIONS=

# Paper-only aggregate stop-risk ceiling (optional ZAR value overrides the fraction)
BREAKWATER_PAPER_MAX_AGGREGATE_RISK_OF_EQUITY=0.05
BREAKWATER_PAPER_MAX_AGGREGATE_OPEN_RISK_ZAR=
# Slippage/gap stress added to aggregate stop risk (set to 0 to disable)
BREAKWATER_PAPER_AGGREGATE_RISK_BUFFER_BPS=25

# Spot margin (OFF by default; requires explicit ack)
BREAKWATER_ENABLE_SPOT_MARGIN_SHORTS=0
BREAKWATER_SPOT_MARGIN_ACK=off

# Dead-man ping URL (GitHub Secret, not a Variable: it is a capability).
# Absent => commit_state.sh skips the ping entirely.
BREAKWATER_HEARTBEAT_URL=

# --- Venue posture -----------------------------------------------------------
# VALR Perps are RETIRED. The account cannot reach /simple-futures (401 on every
# authenticated call with a valid, correctly-scoped key) and this system cannot
# open VALR futures anyway (execution locks them). Hyperliquid is the
# authoritative perp venue. Set to 0 to restore the old behaviour, where an
# unverifiable perps API halts live mode.
BREAKWATER_VALR_PERPS_RETIRED=1

# --- Paper re-entry accounting ----------------------------------------------
# One signal, one position: a signal_id that already opened a position cannot
# open another. Guards the artifact where one LINKZAR signal closed 28 times
# (+269.82 ZAR of a +398.78 ZAR spot lane) at a stale entry price.
BREAKWATER_PAPER_ONE_ENTRY_PER_SIGNAL=1
# Mirror of the falling-knife guard: refuse an entry whose +2R target has
# already printed, because the move it was chasing is already gone.
BREAKWATER_PAPER_THROUGH_TARGET_GUARD=1

# --- Venue cost basis --------------------------------------------------------
# Margin of safety applied to a CO spot slice's per-pair round trip: the row's
# edge must clear this many times the pair's own cost (70 bps ZAR -> 140 bps).
# 0 disables the gate. Perp is uniform (9 bps) and unaffected.
BREAKWATER_VENUE_COST_MULT=2

# --- Promotion evidence ------------------------------------------------------
# Minimum counted closes before a slice is written to the promotion registry.
BREAKWATER_PROMOTION_MIN_SLICE_TRADES=5
